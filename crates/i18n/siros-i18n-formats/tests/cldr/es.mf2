# The formats of es from CLDR 49.0.0 (unicode-org/cldr-json), written by siros-cldr.
@locale es
@dir ltr
---

[tables]
digits = 0123456789
decimal = ,
group = .
minus = -
plus = +
grouping = 2
plural.cardinal =
  one: n = 1
  many: e = 0 and i != 0 and i % 1000000 = 0 and v = 0 or e != 0..5
plural.ordinal =
  one: n % 10 = 1,3 and n % 100 != 11
