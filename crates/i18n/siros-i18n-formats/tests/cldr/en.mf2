# The formats of en from CLDR 49.0.0 (unicode-org/cldr-json), written by siros-cldr.
@locale en
@dir ltr
---

[tables]
digits = 0123456789
decimal = .
group = ,
minus = -
plus = +
grouping = 1
plural.cardinal =
  one: i = 1 and v = 0
plural.ordinal =
  one: n % 10 = 1 and n % 100 != 11
  two: n % 10 = 2 and n % 100 != 12
  few: n % 10 = 3 and n % 100 != 13
