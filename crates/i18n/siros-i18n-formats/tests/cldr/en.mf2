months.wide =
  1 January
  2 February
  3 March
  4 April
  5 May
  6 June
  7 July
  8 August
  9 September
  10 October
  11 November
  12 December
months.abbreviated =
  1 Jan
  2 Feb
  3 Mar
  4 Apr
  5 May
  6 Jun
  7 Jul
  8 Aug
  9 Sep
  10 Oct
  11 Nov
  12 Dec
days.wide =
  1 Monday
  2 Tuesday
  3 Wednesday
  4 Thursday
  5 Friday
  6 Saturday
  7 Sunday
days.abbreviated =
  1 Mon
  2 Tue
  3 Wed
  4 Thu
  5 Fri
  6 Sat
  7 Sun
periods =
  0 AM
  1 PM
eras =
  0 BC
  1 AD

[formats.number]
of = number
default = yes
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.integer]
of = number
maximumFractionDigits = 0
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.currency]
of = amount
default = yes
option.currencyDisplay = symbol narrowSymbol code name never
option.currencySign = standard accounting
minimumFractionDigits = {currency:table=currency.digits}
maximumFractionDigits = {currency:table=currency.digits}
pattern =
  [currencyDisplay=never currencySign=accounting sign=minus] ({int:group=3}{frac})
  [currencyDisplay=never currencySign=accounting] {sign}{int:group=3}{frac}
  [currencyDisplay=never] {sign}{int:group=3}{frac}
  [currencyDisplay=name plural=one] {sign}{int:group=3}{frac} {currency:table=currency.name.one|currency.name.other}
  [currencyDisplay=name] {sign}{int:group=3}{frac} {currency:table=currency.name.other}
  [currencyDisplay=narrowSymbol currencySign=accounting currency@currency.narrow.tight sign=minus] ({currency:table=currency.narrow}{int:group=3}{frac})
  [currencyDisplay=narrowSymbol currencySign=accounting currency@currency.narrow.tight] {sign}{currency:table=currency.narrow}{int:group=3}{frac}
  [currencyDisplay=narrowSymbol currencySign=accounting sign=minus] ({currency:table=currency.narrow} {int:group=3}{frac})
  [currencyDisplay=narrowSymbol currencySign=accounting] {sign}{currency:table=currency.narrow} {int:group=3}{frac}
  [currencyDisplay=narrowSymbol currency@currency.narrow.tight] {sign}{currency:table=currency.narrow}{int:group=3}{frac}
  [currencyDisplay=narrowSymbol] {sign}{currency:table=currency.narrow} {int:group=3}{frac}
  [currencyDisplay=symbol currencySign=accounting currency@currency.symbol.tight sign=minus] ({currency:table=currency.symbol}{int:group=3}{frac})
  [currencyDisplay=symbol currencySign=accounting currency@currency.symbol.tight] {sign}{currency:table=currency.symbol}{int:group=3}{frac}
  [currencyDisplay=symbol currencySign=accounting sign=minus] ({currency:table=currency.symbol} {int:group=3}{frac})
  [currencyDisplay=symbol currencySign=accounting] {sign}{currency:table=currency.symbol} {int:group=3}{frac}
  [currencyDisplay=symbol currency@currency.symbol.tight] {sign}{currency:table=currency.symbol}{int:group=3}{frac}
  [currencyDisplay=symbol] {sign}{currency:table=currency.symbol} {int:group=3}{frac}
  [currencyDisplay=code currencySign=accounting sign=minus] ({currency} {int:group=3}{frac})
  [currencyDisplay=code currencySign=accounting] {sign}{currency} {int:group=3}{frac}
  [currencyDisplay=code] {sign}{currency} {int:group=3}{frac}

[formats.date]
of = date
default = yes
option.length = medium short long full
pattern =
  [length=medium year<1000] {month:table=months.abbreviated} {day}, {era-year} {era:table=eras}
  [length=medium] {month:table=months.abbreviated} {day}, {year}
  [length=short year<1000] {month}/{day}/{era-year} {era:table=eras}
  [length=short year>=1950 year<2050] {month}/{day}/{year:last=2,pad=2}
  [length=short] {month}/{day}/{year}
  [length=long year<1000] {month:table=months.wide} {day}, {era-year} {era:table=eras}
  [length=long] {month:table=months.wide} {day}, {year}
  [length=full year<1000] {weekday:table=days.wide}, {month:table=months.wide} {day}, {era-year} {era:table=eras}
  [length=full] {weekday:table=days.wide}, {month:table=months.wide} {day}, {year}

[formats.time]
of = time
default = yes
option.length = medium short long full
pattern =
  [length=medium] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}
  [length=short] {hour12}:{minute:pad=2} {period:table=periods}
  [length=long offset? offset-sign=1 offset-minutes>0] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours}:{offset-minutes:pad=2}
  [length=long offset? offset-sign=1] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours}
  [length=long offset? offset-minutes>0] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT+{offset-hours}:{offset-minutes:pad=2}
  [length=long offset?] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT+{offset-hours}
  [length=long] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}
  [length=full offset? offset-sign=1] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours:pad=2}:{offset-minutes:pad=2}
  [length=full offset?] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT+{offset-hours:pad=2}:{offset-minutes:pad=2}
  [length=full] {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}

[formats.datetime]
of = datetime
default = yes
option.length = medium short long full
pattern =
  [length=medium year<1000] {month:table=months.abbreviated} {day}, {era-year} {era:table=eras}, {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}
  [length=medium] {month:table=months.abbreviated} {day}, {year}, {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}
  [length=short year<1000] {month}/{day}/{era-year} {era:table=eras}, {hour12}:{minute:pad=2} {period:table=periods}
  [length=short year>=1950 year<2050] {month}/{day}/{year:last=2,pad=2}, {hour12}:{minute:pad=2} {period:table=periods}
  [length=short] {month}/{day}/{year}, {hour12}:{minute:pad=2} {period:table=periods}
  [length=long year<1000 offset? offset-sign=1 offset-minutes>0] {month:table=months.wide} {day}, {era-year} {era:table=eras} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours}:{offset-minutes:pad=2}
  [length=long year<1000 offset? offset-sign=1] {month:table=months.wide} {day}, {era-year} {era:table=eras} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours}
  [length=long year<1000 offset? offset-minutes>0] {month:table=months.wide} {day}, {era-year} {era:table=eras} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT+{offset-hours}:{offset-minutes:pad=2}
  [length=long year<1000 offset?] {month:table=months.wide} {day}, {era-year} {era:table=eras} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT+{offset-hours}
  [length=long year<1000] {month:table=months.wide} {day}, {era-year} {era:table=eras} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods}
  [length=long offset? offset-sign=1 offset-minutes>0] {month:table=months.wide} {day}, {year} at {hour12}:{minute:pad=2}:{second:pad=2} {period:table=periods} GMT-{offset-hours}:{offset-minutes:pad=2}
