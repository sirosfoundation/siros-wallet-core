months.wide =
  1 janvier
  2 février
  3 mars
  4 avril
  5 mai
  6 juin
  7 juillet
  8 août
  9 septembre
  10 octobre
  11 novembre
  12 décembre
months.abbreviated =
  1 janv.
  2 févr.
  3 mars
  4 avr.
  5 mai
  6 juin
  7 juil.
  8 août
  9 sept.
  10 oct.
  11 nov.
  12 déc.
days.wide =
  1 lundi
  2 mardi
  3 mercredi
  4 jeudi
  5 vendredi
  6 samedi
  7 dimanche
days.abbreviated =
  1 lun.
  2 mar.
  3 mer.
  4 jeu.
  5 ven.
  6 sam.
  7 dim.
periods =
  0 AM
  1 PM
eras =
  0 av. J.-C.
  1 ap. J.-C.

[formats.number]
of = number
default = yes
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.integer]
of = number
maximumFractionDigits = 0
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.currency]
of = amount
default = yes
option.currencyDisplay = symbol narrowSymbol code name never
option.currencySign = standard accounting
minimumFractionDigits = {currency:table=currency.digits}
maximumFractionDigits = {currency:table=currency.digits}
pattern =
  [currencyDisplay=never currencySign=accounting sign=minus] ({int:group=3}{frac})
  [currencyDisplay=never currencySign=accounting] {sign}{int:group=3}{frac}
  [currencyDisplay=never] {sign}{int:group=3}{frac}
  [currencyDisplay=name plural=one] {sign}{int:group=3}{frac} {currency:table=currency.name.one|currency.name.other}
  [currencyDisplay=name plural=many] {sign}{int:group=3}{frac} {currency:table=currency.name.other}
  [currencyDisplay=name] {sign}{int:group=3}{frac} {currency:table=currency.name.other}
  [currencyDisplay=narrowSymbol currencySign=accounting currency@currency.narrow.tight sign=minus] ({int:group=3}{frac} {currency:table=currency.narrow})
  [currencyDisplay=narrowSymbol currencySign=accounting currency@currency.narrow.tight] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol currencySign=accounting sign=minus] ({int:group=3}{frac} {currency:table=currency.narrow})
  [currencyDisplay=narrowSymbol currencySign=accounting] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol currency@currency.narrow.tight] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=symbol currencySign=accounting currency@currency.symbol.tight sign=minus] ({int:group=3}{frac} {currency:table=currency.symbol})
  [currencyDisplay=symbol currencySign=accounting currency@currency.symbol.tight] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol currencySign=accounting sign=minus] ({int:group=3}{frac} {currency:table=currency.symbol})
  [currencyDisplay=symbol currencySign=accounting] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol currency@currency.symbol.tight] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=code currencySign=accounting sign=minus] ({int:group=3}{frac} {currency})
  [currencyDisplay=code currencySign=accounting] {sign}{int:group=3}{frac} {currency}
  [currencyDisplay=code] {sign}{int:group=3}{frac} {currency}

[formats.date]
of = date
default = yes
option.length = medium short long full
pattern =
  [length=medium year<1000] {day} {month:table=months.abbreviated} {era-year} {era:table=eras}
  [length=medium] {day} {month:table=months.abbreviated} {era-year}
  [length=short year<1000] {day:pad=2}/{month:pad=2}/{era-year} {era:table=eras}
  [length=short] {day:pad=2}/{month:pad=2}/{era-year}
  [length=long year<1000] {day} {month:table=months.wide} {era-year} {era:table=eras}
  [length=long] {day} {month:table=months.wide} {era-year}
  [length=full year<1000] {weekday:table=days.wide} {day} {month:table=months.wide} {era-year} {era:table=eras}
  [length=full] {weekday:table=days.wide} {day} {month:table=months.wide} {era-year}

[formats.time]
of = time
default = yes
option.length = medium short long full
pattern =
  [length=medium] {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=short] {hour:pad=2}:{minute:pad=2}
  [length=long offset? offset-sign=1 offset-minutes>0] {hour:pad=2}:{minute:pad=2}:{second:pad=2} UTC-{offset-hours}:{offset-minutes:pad=2}
  [length=long offset? offset-sign=1] {hour:pad=2}:{minute:pad=2}:{second:pad=2} UTC-{offset-hours}
  [length=long offset? offset-minutes>0] {hour:pad=2}:{minute:pad=2}:{second:pad=2} UTC+{offset-hours}:{offset-minutes:pad=2}
