  1 Montag
  2 Dienstag
  3 Mittwoch
  4 Donnerstag
  5 Freitag
  6 Samstag
  7 Sonntag
days.abbreviated =
  1 Mo.
  2 Di.
  3 Mi.
  4 Do.
  5 Fr.
  6 Sa.
  7 So.
periods =
  0 AM
  1 PM
eras =
  0 v. Chr.
  1 n. Chr.

[formats.number]
of = number
default = yes
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.integer]
of = number
maximumFractionDigits = 0
select = plural
pattern =
  {sign}{int:group=3}{frac}

[formats.currency]
of = amount
default = yes
option.currencyDisplay = symbol narrowSymbol code name never
option.currencySign = standard accounting
minimumFractionDigits = {currency:table=currency.digits}
maximumFractionDigits = {currency:table=currency.digits}
pattern =
  [currencyDisplay=never currencySign=accounting] {sign}{int:group=3}{frac}
  [currencyDisplay=never] {sign}{int:group=3}{frac}
  [currencyDisplay=name plural=one] {sign}{int:group=3}{frac} {currency:table=currency.name.one|currency.name.other}
  [currencyDisplay=name] {sign}{int:group=3}{frac} {currency:table=currency.name.other}
  [currencyDisplay=narrowSymbol currencySign=accounting currency@currency.narrow.tight] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol currencySign=accounting] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol currency@currency.narrow.tight] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=narrowSymbol] {sign}{int:group=3}{frac} {currency:table=currency.narrow}
  [currencyDisplay=symbol currencySign=accounting currency@currency.symbol.tight] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol currencySign=accounting] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol currency@currency.symbol.tight] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=symbol] {sign}{int:group=3}{frac} {currency:table=currency.symbol}
  [currencyDisplay=code currencySign=accounting] {sign}{int:group=3}{frac} {currency}
  [currencyDisplay=code] {sign}{int:group=3}{frac} {currency}

[formats.date]
of = date
default = yes
option.length = medium short long full
pattern =
  [length=medium year<1000] {day:pad=2}.{month:pad=2}.{era-year} {era:table=eras}
  [length=medium] {day:pad=2}.{month:pad=2}.{era-year}
  [length=short year<1000] {day:pad=2}.{month:pad=2}.{era-year} {era:table=eras}
  [length=short year>=1950 year<2050] {day:pad=2}.{month:pad=2}.{era-year:last=2,pad=2}
  [length=short] {day:pad=2}.{month:pad=2}.{era-year}
  [length=long year<1000] {day}. {month:table=months.wide} {era-year} {era:table=eras}
  [length=long] {day}. {month:table=months.wide} {era-year}
  [length=full year<1000] {day} {month:table=months.wide} {era-year} {era:table=eras}, {weekday:table=days.wide}
  [length=full] {weekday:table=days.wide}, {day}. {month:table=months.wide} {era-year}

[formats.time]
of = time
default = yes
option.length = medium short long full
pattern =
  [length=medium] {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=short] {hour:pad=2}:{minute:pad=2}
  [length=long offset? offset-sign=1 offset-minutes>0] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}:{offset-minutes:pad=2}
  [length=long offset? offset-sign=1] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}
  [length=long offset? offset-minutes>0] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}:{offset-minutes:pad=2}
  [length=long offset?] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}
  [length=long] {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=full offset? offset-sign=1] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours:pad=2}:{offset-minutes:pad=2}
  [length=full offset?] {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours:pad=2}:{offset-minutes:pad=2}
  [length=full] {hour:pad=2}:{minute:pad=2}:{second:pad=2}

[formats.datetime]
of = datetime
default = yes
option.length = medium short long full
pattern =
  [length=medium year<1000] {day:pad=2}.{month:pad=2}.{era-year} {era:table=eras}, {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=medium] {day:pad=2}.{month:pad=2}.{era-year}, {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=short year<1000] {day:pad=2}.{month:pad=2}.{era-year} {era:table=eras}, {hour:pad=2}:{minute:pad=2}
  [length=short year>=1950 year<2050] {day:pad=2}.{month:pad=2}.{era-year:last=2,pad=2}, {hour:pad=2}:{minute:pad=2}
  [length=short] {day:pad=2}.{month:pad=2}.{era-year}, {hour:pad=2}:{minute:pad=2}
  [length=long year<1000 offset? offset-sign=1 offset-minutes>0] {day}. {month:table=months.wide} {era-year} {era:table=eras} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}:{offset-minutes:pad=2}
  [length=long year<1000 offset? offset-sign=1] {day}. {month:table=months.wide} {era-year} {era:table=eras} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}
  [length=long year<1000 offset? offset-minutes>0] {day}. {month:table=months.wide} {era-year} {era:table=eras} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}:{offset-minutes:pad=2}
  [length=long year<1000 offset?] {day}. {month:table=months.wide} {era-year} {era:table=eras} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}
  [length=long year<1000] {day}. {month:table=months.wide} {era-year} {era:table=eras} um {hour:pad=2}:{minute:pad=2}:{second:pad=2}
  [length=long offset? offset-sign=1 offset-minutes>0] {day}. {month:table=months.wide} {era-year} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}:{offset-minutes:pad=2}
  [length=long offset? offset-sign=1] {day}. {month:table=months.wide} {era-year} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT-{offset-hours}
  [length=long offset? offset-minutes>0] {day}. {month:table=months.wide} {era-year} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}:{offset-minutes:pad=2}
  [length=long offset?] {day}. {month:table=months.wide} {era-year} um {hour:pad=2}:{minute:pad=2}:{second:pad=2} GMT+{offset-hours}
