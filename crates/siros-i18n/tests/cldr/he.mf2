[formats.date]
zero = 0
date-short = d.M.y
date-medium = d בMMM y
date-long = d בMMMM y
date-full = EEEE, d בMMMM y
time-short = H:mm
time-medium = H:mm:ss
time-long = H:mm:ss z
time-full = H:mm:ss zzzz
datetime-short = {1}, {0}
