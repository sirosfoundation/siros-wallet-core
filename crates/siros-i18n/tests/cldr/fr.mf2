[formats.date]
zero = 0
date-short = dd/MM/y
date-medium = d MMM y
date-long = d MMMM y
date-full = EEEE d MMMM y
time-short = HH:mm
time-medium = HH:mm:ss
time-long = HH:mm:ss z
time-full = HH:mm:ss zzzz
datetime-short = {1} {0}
datetime-medium = {1}, {0}
datetime-long = {1} 'à' {0}
datetime-full = {1} 'à' {0}
months-wide =
  janvier
  février
  mars
  avril
  mai
  juin
  juillet
  août
  septembre
  octobre
  novembre
  décembre
