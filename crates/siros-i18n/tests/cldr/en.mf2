[formats.date]
zero = 0
date-short = M/d/yy
date-medium = MMM d, y
date-long = MMMM d, y
date-full = EEEE, MMMM d, y
time-short = h:mm a
time-medium = h:mm:ss a
time-long = h:mm:ss a z
time-full = h:mm:ss a zzzz
datetime-short = {1}, {0}
datetime-medium = {1}, {0}
datetime-long = {1} 'at' {0}
datetime-full = {1} 'at' {0}
months-wide =
  January
  February
  March
  April
  May
  June
  July
  August
  September
  October
  November
  December
months-abbreviated =
  Jan
  Feb
  Mar
  Apr
  May
  Jun
  Jul
  Aug
  Sep
  Oct
  Nov
  Dec
days-wide =
  Sunday
  Monday
  Tuesday
  Wednesday
  Thursday
  Friday
  Saturday
days-abbreviated =
  Sun
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
periods =
  AM
  PM
zone-gmt = GMT{0}
zone-hours = +HH:mm;-HH:mm
year-era = y G
eras =
  BC
  AD

[formats.list]
and-start = {0}, {1}
and-middle = {0}, {1}
and-end = {0}, and {1}
and-pair = {0} and {1}
and-special =
or-start = {0}, {1}
or-middle = {0}, {1}
or-end = {0}, or {1}
or-pair = {0} or {1}
or-special =
