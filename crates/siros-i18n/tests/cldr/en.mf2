[formats.date]
zero = 0
date-short = M/d/yy
date-medium = MMM d, y
date-long = MMMM d, y
date-full = EEEE, MMMM d, y
time-short = h:mm a
time-medium = h:mm:ss a
time-long = h:mm:ss a z
time-full = h:mm:ss a zzzz
datetime-short = {1}, {0}
datetime-medium = {1}, {0}
datetime-long = {1} 'at' {0}
datetime-full = {1} 'at' {0}
