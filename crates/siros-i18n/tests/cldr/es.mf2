  dom
  lun
  mar
  mié
  jue
  vie
  sáb
periods =
  a. m.
  p. m.
zone-gmt = GMT{0}
zone-hours = +HH:mm;-HH:mm
year-era = y G
eras =
  a. C.
  d. C.
