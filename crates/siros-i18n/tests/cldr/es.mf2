[formats.date]
zero = 0
date-short = d/M/yy
date-medium = d MMM y
date-long = d 'de' MMMM 'de' y
date-full = EEEE, d 'de' MMMM 'de' y
time-short = H:mm
time-medium = H:mm:ss
time-long = H:mm:ss z
time-full = H:mm:ss (zzzz)
datetime-short = {1}, {0}
datetime-medium = {1}, {0}
datetime-long = {1} 'a' 'las' {0}
datetime-full = {1}, {0}
months-wide =
  enero
  febrero
  marzo
  abril
  mayo
  junio
  julio
  agosto
  septiembre
  octubre
  noviembre
  diciembre
