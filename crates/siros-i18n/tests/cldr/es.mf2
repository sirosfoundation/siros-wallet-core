# The format options of es from CLDR 49.0.0 (unicode-org/cldr-json), written by siros-cldr.
@locale es
@dir ltr
---

[formats.number]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 2
cardinal =
  one: n = 1
  many: e = 0 and i != 0 and i % 1000000 = 0 and v = 0 or e != 0..5
ordinal =
  one: n % 10 = 1,3 and n % 100 != 11
pattern = #,##0.###

[formats.offset]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 2
cardinal =
  one: n = 1
  many: e = 0 and i != 0 and i % 1000000 = 0 and v = 0 or e != 0..5
ordinal =
  one: n % 10 = 1,3 and n % 100 != 11
pattern = #,##0.###

[formats.currency]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 2
cardinal =
  one: n = 1
  many: e = 0 and i != 0 and i % 1000000 = 0 and v = 0 or e != 0..5
ordinal =
  one: n % 10 = 1,3 and n % 100 != 11
percent-sign = %
percent-pattern = #,##0 %
pattern = #,##0.###
standard = #,##0.00 ¤
standard-alpha = #,##0.00 ¤
accounting = #,##0.00 ¤
accounting-alpha = #,##0.00 ¤
no-currency = #,##0.00
no-currency-accounting = #,##0.00
unit-pattern =
  other {0} {1}
