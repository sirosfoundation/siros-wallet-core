# The format options of de from CLDR 49.0.0 (unicode-org/cldr-json), written by siros-cldr.
@locale de
@dir ltr
---

[formats.number]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 1
cardinal =
  one: i = 1 and v = 0
ordinal =
pattern = #,##0.###

[formats.offset]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 1
cardinal =
  one: i = 1 and v = 0
ordinal =
pattern = #,##0.###

[formats.currency]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 1
cardinal =
  one: i = 1 and v = 0
ordinal =
percent-sign = %
percent-pattern = #,##0 %
pattern = #,##0.###
standard = #,##0.00 ¤
standard-alpha = #,##0.00 ¤
accounting = #,##0.00 ¤
accounting-alpha = #,##0.00 ¤
no-currency = #,##0.00
