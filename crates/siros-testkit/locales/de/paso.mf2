# The test app's German wording of siros-paso's statements.
@locale de
@dir ltr
---

[paso.mandate]
mandate_id = Mandatsreferenz
mandatee = Bevollmächtigte Partei
action = Erlaubte Handlung
conditions = Bedingungen
max_amount = Höchstbetrag pro Nutzung
max_count = Höchstzahl der Nutzungen
period = Zeitraum
valid_from = Gültig ab
valid_until = Gültig bis
amount = Betrag
payee = Empfänger
payee_logo = Logo des Empfängers

[paso.title]
transaction = Transaktion bestätigen
payment = Zahlungsbestätigung
data_sharing = Datenfreigabe erlauben
generic_payment = Zahlung bestätigen
account_delegate = Kontovollmacht erteilen
recurring_payment = Wiederkehrende Zahlung erlauben
agent_purchase = Agentenkauf erlauben
mandate = Mandat erteilen

[paso.confirm]
confirm = Bestätigen
allow_sharing = Erlauben
pay = Bezahlen
delegate = Vollmacht erteilen
mandate = Mandat erteilen
agent = Agent erlauben
authorize = Erteilen

[paso.section]
payment_details = Zahlungsdetails
first_collection = Erste Abbuchung
payment = Zahlung

[paso.frequency]
inda = untertägig
dail = täglich
week = wöchentlich
towk = alle zwei Wochen
twmn = zweimal im Monat
mnth = monatlich
tomn = alle zwei Monate
qutr = vierteljährlich
fomn = alle vier Monate
semi = halbjährlich
year = jährlich
tyea = alle zwei Jahre

[paso.value]
time = {$value :siros:time}
currency = {$code}
amount = {$value :currency currency=$currency}

[paso.array_at]
claim = die Bezeichnungen des Claims {$path}
ui = die Bezeichnungen von {$key}

[paso.rendered_at]
claim = die Bezeichnung des Claims {$claim}
ui = die Bezeichnung {$key}
