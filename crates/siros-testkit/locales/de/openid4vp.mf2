@dir ltr
---

[openid4vp.wallet]
deny = Abbrechen
share = Teilen
none = Keine
credential = Nachweis
request_title = Daten teilen
yes = Ja
no = Nein
claim = Angabe
null = Kein Wert
text = {$value}
