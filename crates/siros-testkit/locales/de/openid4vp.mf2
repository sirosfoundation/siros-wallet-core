# The test app's German source of the openid4vp module. The number format's options are siros-cldr's.
@locale de
@dir ltr
---

[wallet]
deny = Abbrechen
share = Teilen
none = Keine
credential = Nachweis
request_title = Daten teilen
yes = Ja
no = Nein
claim = Angabe
null = Kein Wert
bytes = {$length :integer} Byte

[formats.number]
zero = 0
decimal = ,
group = .
minus = -
plus = +
grouping = 1
cardinal =
  one: i = 1 and v = 0
ordinal =
pattern = #,##0.###
