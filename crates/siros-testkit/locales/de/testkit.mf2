# The test app's German wording of the test doubles.
@locale de
@dir ltr
---

[testkit.format]
monthly = monatlich
written = {$text}
date = {$value}
time = {$value}
date_time = {$value}
currency = {$code}
amount = {$value :currency currency=$currency}

[testkit.profile]
reference = Referenz
section = Abschnitt
logo = Logo
merchant = Händler
confirm = Bestätigen
entries = Einträge {$reference}
hint = Hinweis {$reference}
