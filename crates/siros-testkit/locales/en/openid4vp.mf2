# The test app's English wording of siros-openid4vp's statements.
@locale en
@dir ltr
---

[openid4vp.wallet]
deny = Cancel
share = Share
none = None
credential = Credential
request_title = Share your data
yes = Yes
no = No
claim = claim
null = None
text = {$value}
number = {$value :number}
date = {$value :siros:date}
date_time = {$value :siros:datetime}
bytes = {$length :integer} bytes
label = {$label}
