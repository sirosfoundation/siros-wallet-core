# The test app's English wording of siros-paso's statements.
@locale en
@dir ltr
---

[paso.mandate]
mandate_id = Mandate reference
mandatee = Authorized party
action = Authorized action
conditions = Conditions
max_amount = Maximum amount per use
max_count = Maximum uses
period = Per period
valid_from = Valid from
valid_until = Valid until
amount = Amount
payee = Payee
payee_logo = Payee logo

[paso.title]
transaction = Confirm Transaction
payment = Payment Confirmation
data_sharing = Authorize Data Sharing
generic_payment = Confirm Payment
account_delegate = Authorize Account Delegate
recurring_payment = Authorize Recurring Payment
agent_purchase = Authorize Agent Purchase
mandate = Authorize Mandate

[paso.confirm]
confirm = Confirm
allow_sharing = Authorize
pay = Pay
delegate = Authorize Delegate
mandate = Authorize Mandate
agent = Authorize Agent
authorize = Authorize

[paso.section]
payment_details = Payment Details
first_collection = First Collection
payment = Payment

[paso.frequency]
inda = intraday
dail = daily
week = weekly
towk = every two weeks
twmn = twice a month
mnth = monthly
tomn = every two months
qutr = quarterly
fomn = every four months
semi = twice a year
year = yearly
tyea = every two years

[paso.value]
time = {$value :siros:time}
currency = {$code}
amount = {$value :currency currency=$currency}

[paso.array_at]
claim = the labels of the claim {$path}
ui = the labels of {$key}

[paso.rendered_at]
claim = the label of the claim {$claim}
ui = the label {$key}
